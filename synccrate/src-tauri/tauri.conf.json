{
  "productName": "SyncCrate",
  "version": "0.7.5",
  "identifier": "com.synccrate.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SyncCrate",
        "width": 1100,
        "height": 700,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "minWidth": 900,
        "minHeight": 600,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installerHooks": "windows/hooks.nsh",
        "headerImage": "windows/header.bmp",
        "sidebarImage": "windows/sidebar.bmp"
      },
      "wix": {
        "bannerPath": "windows/wix-banner.bmp",
        "dialogImagePath": "windows/wix-dialog.bmp"
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "fileAssociations": [
      {
        "ext": ["scpack"],
        "name": "SyncCrate Modpack",
        "description": "SyncCrate modpack",
        "mimeType": "application/x-synccrate-pack",
        "role": "Viewer"
      }
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["synccrate"]
      }
    },
    "updater": {
      "endpoints": [
        "https://github.com/stixez/SyncCrate/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI2QkEyMzg0QTM3NTM1QzcKUldUSE5YV2poQ082SnVUZW9sZVB2TDREakdkVnA3bDdxaEJ6aDErQmM0RVBTaXBGYy9XZlN1QTUK"
    }
  }
}
